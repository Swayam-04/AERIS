

# AERIS Persistent Database Configuration
# PostgreSQL + TimescaleDB Connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aeris_db

# Telemetry Persistence Queue & Batch Configuration
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL=1.0
TELEMETRY_PERSISTENCE_QUEUE_SIZE=5000
TELEMETRY_DB_RETRY_INTERVAL=5.0
DATABASE_ECHO=false
